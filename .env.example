# Public — exposed to the browser
NEXT_PUBLIC_SITE_URL=https://www.vpbuyshomes.com

# Mapbox Geocoding — powers the address-autocomplete dropdown on the lead form.
# Optional: if unset, the address field degrades gracefully to a plain text input.
# 1. Sign up at https://account.mapbox.com → create a "public" access token
# 2. Restrict the token to URLs: vpbuyshomes.com, *.vercel.app, localhost:*
# 3. Free tier is 100,000 requests/month — well above expected lead volume
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend — lead notification emails
# https://resend.com/api-keys
# IMPORTANT: if you have NOT yet verified vpbuyshomes.com in Resend, sends from
# leads@vpbuyshomes.com will fail. The app will automatically retry from
# onboarding@resend.dev (Resend's sandbox) so you still receive leads while DNS
# propagates. Verify the domain in Resend Dashboard → Domains to remove the fallback.
RESEND_API_KEY=

# Where lead notifications are sent. Defaults to traver97@gmail.com if unset.
LEAD_NOTIFICATION_EMAIL=traver97@gmail.com

# Google Sheets — lead log via a Google Apps Script web app webhook.
# Optional; if unset, leads fall back to writing .data/leads.json on the server.
# Set up:
#  1. Create a Google Sheet
#  2. Extensions → Apps Script → add a doPost handler that appends the JSON body as a row
#     (the script itself is not stored in this repo)
#  3. Deploy → Web app → Execute as: Me, Access: Anyone
#  4. Copy the /exec URL here
SHEETS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Ads / Analytics — all optional. Site behaves identically when unset; pixels
# stay inert. Set these in Vercel → Settings → Environment Variables once the
# corresponding ad accounts exist. No code changes needed to flip on tracking.
# ─────────────────────────────────────────────────────────────────────────────

# Meta (Facebook/Instagram) Pixel — browser-side tracking.
# Get from: business.facebook.com → Events Manager → Data Sources → your Pixel.
# Format: 15-16 digit numeric ID.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API token — server-side conversion forwarding (recommended,
# much more accurate than pixel-only since iOS 14). Generated alongside the
# Pixel: Events Manager → Settings → Conversions API → Generate Access Token.
# Treated as a server secret — do NOT prefix with NEXT_PUBLIC_.
META_CONVERSION_API_TOKEN=

# Optional. Use a test_event_code from Events Manager → Test Events while
# verifying that server-side events are arriving. Leave unset in production.
META_CONVERSION_API_TEST_CODE=

# Meta domain verification meta tag content (just the token, not the full tag).
# Get from: Business Settings → Brand Safety → Domains → vpbuyshomes.com →
# "Meta-tag Verification". The site emits the full <meta> tag automatically.
META_DOMAIN_VERIFICATION=

# Google Analytics 4 — Measurement ID, format G-XXXXXXXXXX.
# Get from: analytics.google.com → Admin → Data Streams → Web → your stream.
NEXT_PUBLIC_GA_ID=

# Google Ads — conversion tracking. Both required for the Google Ads conversion
# event to fire on lead submit.
#  - CONVERSION_ID is the AW-XXXXXXXXX value from Google Ads → Goals → Conversions.
#  - LEAD_LABEL is the conversion label string for your "Lead" action (the part
#    after the slash in the gtag snippet Google Ads gives you).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Google Search Console site verification meta tag content.
# Get from: Search Console → property settings → Ownership verification →
# HTML tag. Paste only the content="..." value here.
GOOGLE_SITE_VERIFICATION=

# Set to 'true' to log every analytics event to the browser console — useful
# for debugging in dev. Safe to leave on; events fire either way.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Google Search Console — powers `npm run gsc:check` (local-only tool).
# One-time setup:
#  1. Keep the OAuth client JSON downloaded from Google Cloud Console (Desktop app)
#     stored outside the repo, e.g. ~/.config/vpbuyshomes/oauth-client.json
#  2. Run `npm run gsc:auth /path/to/oauth-client.json` — it opens a browser,
#     you grant consent, and it prints these env values for you to paste here.
#  3. Then `npm run gsc:check` will print sitemap status, index coverage, and
#     top queries/pages from the last 7 days.
# Property URL format must match exactly what's in Search Console:
#   Domain property:     sc-domain:vpbuyshomes.com
#   URL-prefix property: https://vpbuyshomes.com/
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=https://vpbuyshomes.com/
